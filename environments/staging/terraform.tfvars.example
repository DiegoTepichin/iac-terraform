aws_region      = "us-east-1"
environment     = "staging"
instance_type   = "t3.small"
public_key_path = "~/.ssh/id_rsa.pub"

# REEMPLAZA CON TU IP PUBLICA (curl -s ifconfig.me). 0.0.0.0/0 es rechazado por validacion.
my_ip = "DIRECCION_IP_PUBLICA/32"

# Staging usa su propio rango CIDR para VPC
# vpc_cidr = "10.1.0.0/16"

# NAT Gateway habilitado por defecto en staging
# enable_nat_gateway = true
