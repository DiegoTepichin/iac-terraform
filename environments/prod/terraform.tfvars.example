aws_region      = "us-east-1"
environment     = "prod"
instance_type   = "t3.medium"
public_key_path = "~/.ssh/id_rsa.pub"

# REEMPLAZA CON TU IP PUBLICA (curl -s ifconfig.me). 0.0.0.0/0 es rechazado por validacion.
my_ip = "DIRECCION_IP_PUBLICA/32"

# Produccion usa VPC dedicada
# vpc_cidr = "10.2.0.0/16"

# NAT Gateway SIEMPRE habilitado en produccion
# enable_nat_gateway = true
