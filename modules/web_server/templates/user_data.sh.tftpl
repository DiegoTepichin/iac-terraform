#!/bin/bash
# Bootstrap del web server. cloud-init ejecuta este script como root.
set -euo pipefail

apt-get update -y
apt-get install -y nginx
systemctl enable --now nginx

cat > /var/www/html/index.html <<HTML
<h1>Hola desde mi infraestructura desplegada con Terraform 🚀</h1>
<p>Ambiente: ${environment}</p>
HTML
